res <- radf_tt(y, minw = 20)
print(res)

cv <- radf_tt_cv(n = 200, minw = 20)
summary(res, cv = cv)
tidy(res, cv = cv)
datestamp(res, cv = cv)
autoplot(res, cv = cv)
